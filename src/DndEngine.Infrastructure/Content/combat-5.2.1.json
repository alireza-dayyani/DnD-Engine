  "conditions": [
    {
      "id": "Blinded",
      "source": "SRD-5.2.1 p.177",
      "summary": "Sight-dependent checks fail; own attacks have Disadvantage and incoming attacks have Advantage."
    },
    {
      "id": "Charmed",
      "source": "SRD-5.2.1 p.178",
      "summary": "Cannot attack or harm the charmer; charmer has Advantage on social interaction checks."
    },
    {
      "id": "Deafened",
      "source": "SRD-5.2.1 p.181",
      "summary": "Hearing-dependent checks fail."
    },
    {
      "id": "Exhaustion",
      "source": "SRD-5.2.1 p.181",
      "summary": "Each level subtracts 2 from D20 Tests and 5 feet from Speed; level 6 causes death. Long Rest removes one level."
    },
    {
      "id": "Frightened",
      "source": "SRD-5.2.1 p.182",
      "summary": "Checks and attacks have Disadvantage while source is visible; cannot willingly move closer to source."
    },
    {
      "id": "Grappled",
      "source": "SRD-5.2.1 p.182",
      "summary": "Speed is zero; attacks against creatures other than grappler have Disadvantage. Ends if grappler is Incapacitated or target leaves reach."
    },
    {
      "id": "Incapacitated",
      "source": "SRD-5.2.1 p.184",
      "summary": "Cannot take actions, Bonus Actions or Reactions, concentrate or speak; Initiative has Disadvantage."
    },
    {
      "id": "Invisible",
      "source": "SRD-5.2.1 p.184",
      "summary": "Initiative has Advantage; unseen attacks have Advantage and attackers have Disadvantage unless they can see the creature."
    },
    {
      "id": "Paralyzed",
      "source": "SRD-5.2.1 p.186",
      "summary": "Incapacitated, Speed zero, Strength and Dexterity saves fail; incoming attacks have Advantage and hits within 5 feet are critical."
    },
    {
      "id": "Petrified",
      "source": "SRD-5.2.1 p.186",
      "summary": "Incapacitated, Speed zero, unaware; Strength and Dexterity saves fail, incoming attacks have Advantage, resistance to all damage and immunity to Poisoned."
    },
    {
      "id": "Poisoned",
      "source": "SRD-5.2.1 p.186",
      "summary": "Attacks and ability checks have Disadvantage."
    },
    {
      "id": "Prone",
      "source": "SRD-5.2.1 p.186",
      "summary": "Crawl or spend half Speed to stand; own attacks have Disadvantage. Attacks from within 5 feet have Advantage, others Disadvantage."
    },
    {
      "id": "Restrained",
      "source": "SRD-5.2.1 p.187",
      "summary": "Speed zero; own attacks and Dexterity saves have Disadvantage, incoming attacks have Advantage."
    },
    {
      "id": "Stunned",
      "source": "SRD-5.2.1 p.189",
      "summary": "Incapacitated; Strength and Dexterity saves fail; incoming attacks have Advantage."
